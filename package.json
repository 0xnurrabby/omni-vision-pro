{
  "name": "omni-vision-pro",
  "version": "1.2.0",
  "description": "Production-grade MCP server for ordered image analysis, code context, and safe ZIP inspection.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "omni-vision-pro": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js serve",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "vision",
    "ocr",
    "opencode",
    "claude-desktop"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xnurrabby/omni-vision-pro.git"
  },
  "bugs": {
    "url": "https://github.com/0xnurrabby/omni-vision-pro/issues"
  },
  "homepage": "https://github.com/0xnurrabby/omni-vision-pro#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "adm-zip": "^0.6.0",
    "dotenv": "^17.4.2",
    "jsonc-parser": "^3.3.1",
    "openai": "^6.27.0",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^5.9.3"
  }
}
